# ghost_story — cmake/sanitizers.cmake
# GHOST_STORY_SANITIZE: off | asan (ASan+UBSan, test targets) | tsan (queue/transport)
# Never applied to release builds of the shipped binary.

if(GHOST_STORY_SANITIZE STREQUAL "asan")
    message(STATUS "ghost_story: ASan+UBSan enabled for test targets")
    set(GHOST_STORY_SAN_FLAGS "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all")
    set(GHOST_STORY_SAN_LINK "-fsanitize=address,undefined")
elseif(GHOST_STORY_SANITIZE STREQUAL "tsan")
    message(STATUS "ghost_story: TSan enabled for test targets")
    set(GHOST_STORY_SAN_FLAGS "-fsanitize=thread -fno-omit-frame-pointer")
    set(GHOST_STORY_SAN_LINK "-fsanitize=thread")
else()
    set(GHOST_STORY_SAN_FLAGS "")
    set(GHOST_STORY_SAN_LINK "")
endif()

function(ghost_story_apply_sanitizers target)
    if(NOT GHOST_STORY_SANITIZE STREQUAL "off")
        separate_arguments(GHOST_STORY_SAN_FLAGS)
        target_compile_options(${target} PRIVATE ${GHOST_STORY_SAN_FLAGS})
        separate_arguments(GHOST_STORY_SAN_LINK)
        target_link_options(${target} PRIVATE ${GHOST_STORY_SAN_LINK})
    endif()
endfunction()
