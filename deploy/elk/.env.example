# Ghost Story dev observability — copy to .env (same directory) or export
# the variables in your shell before running compose / setup / smoke.

# Stack image tag for docker compose (any 8.x/9.x works; keep all three
# services on the same version).
ELASTIC_VERSION=9.2.2

# Host directory Filebeat tails (compose only; default matches the app's
# XDG data path). Only needed if you moved it.
# GHOST_STORY_DATA_DIR=$HOME/.local/share/ghost_story

# Host ports for the stack (compose only). Override if 9200/5601 are
# already in use, e.g. by another Elasticsearch on this machine — then
# export matching ES_URL/KIBANA_URL for elk_setup.sh/elk_smoke.sh.
# ES_PORT=9200
# KIBANA_PORT=5601

# --- "many errors" alert rule (scripts/elk_setup.sh) ---
# Fires when more than ERROR_THRESHOLD ERROR/CRIT log entries land within
# the last ERROR_WINDOW_MIN minutes; checked every minute, re-notified
# only when the alert leaves and re-enters the alert state.
ERROR_THRESHOLD=10
ERROR_WINDOW_MIN=5

# Incoming-webhook URL for the alert — a Slack/Discord/ntfy incoming
# webhook or any HTTP endpoint. Unset: the alert is only written to the
# Kibana server log (visible with `docker compose logs kibana`).
# NOTE: webhook connectors need an Elastic Gold+/trial license; on a basic
# license elk_setup.sh falls back to the server-log connector and says so.
# Rerunning elk_setup.sh with a changed URL updates the connector in place.
# WEBHOOK_URL=

# --- auth (scripts/elk_setup.sh + elk_smoke.sh against secured clusters;
# the bundled dev stack runs with security off, so these stay unset) ---
# ES_USER=elastic
# ES_PASS=changeme
# KIBANA_USER / KIBANA_PASS default to ES_USER / ES_PASS when unset.
